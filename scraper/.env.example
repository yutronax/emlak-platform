SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
GEMINI_API_KEYS=
# Geçici Gemini hatasında yeniden denemelerde kullanılan yedek model. Boşsa yedek kapalı.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BAILEYS_WEBHOOK_PORT=8090
BAILEYS_WEBHOOK_SECRET=
BAILEYS_WEBHOOK_HOST=127.0.0.1
WEBHOOK_URL=http://localhost:8090/baileys-webhook
WHATSAPP_SESSION_DIR=./scraper/sidecar/session
AUTO_SUBMIT=false
QUALITY_GATE_THRESHOLD=0.5
# Gemini ayrıştırma optimizasyonu (önbellek, ön-eleme, kısmi regex). Tanımsızsa kapalı.
GEMINI_PARSE_OPTIMIZATION_ENABLED=false
# Kalıcı önbellek okuma zaman aşımı (ms). Geçersiz veya <=0 ise 600.
PARSE_CACHE_READ_TIMEOUT_MS=600
# Kalıcı parse kuyruğu dosyası. Boşsa %LOCALAPPDATA%\emlak-platform\parse-queue.sqlite3 kullanılır.
# Repo ve OneDrive içine yazmayın. Örnek: PARSE_QUEUE_PATH=C:\emlak-platform-data\parse-queue.sqlite3
PARSE_QUEUE_PATH=
