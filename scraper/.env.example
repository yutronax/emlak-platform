SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
GEMINI_API_KEYS=
BAILEYS_WEBHOOK_PORT=8090
BAILEYS_WEBHOOK_SECRET=
BAILEYS_WEBHOOK_HOST=127.0.0.1
WEBHOOK_URL=http://localhost:8090/baileys-webhook
WHATSAPP_SESSION_DIR=./scraper/sidecar/session
AUTO_SUBMIT=false
QUALITY_GATE_THRESHOLD=0.5
# Gemini ayrıştırma optimizasyonu (önbellek, ön-eleme, kısmi regex). Tanımsızsa kapalı.
GEMINI_PARSE_OPTIMIZATION_ENABLED=false
# Kalıcı önbellek okuma zaman aşımı (ms). Geçersiz veya <=0 ise 600.
PARSE_CACHE_READ_TIMEOUT_MS=600
# Geçici parse hatalarında (rate limit, zaman aşımı, ağ/sağlayıcı hatası, geçersiz JSON) toplam deneme
# sayısı. 1..6 aralığına sıkıştırılır; geçersizse 3. Anahtar yoksa (no_key) yeniden denenmez.
PARSE_MAX_ATTEMPTS=3
# Yeniden deneme taban bekleme süresi (sn): base * 2^(deneme-1) + en fazla %10 jitter, üst sınır 30 sn.
# Geçersiz veya negatifse 2.0.
PARSE_RETRY_BASE_SECONDS=2.0
# Parse'ı hatayla biten mesajlar pending_raw_messages tablosunda en fazla 72 saat bekletilir ve
# arka planda yeniden işlenir. Kontrol aralığı (sn): 30..3600 aralığına sıkıştırılır; geçersizse 300.
PENDING_DRAIN_INTERVAL_SECONDS=300
# Bekleyen bir mesajın toplam yeniden işleme denemesi; dolunca 'dead' işaretlenir (süre bitince silinir).
# 1..20 aralığına sıkıştırılır; geçersizse 8. Denemeler arası bekleme: min(6 sa, 5 dk * 2^deneme).
PENDING_MAX_ATTEMPTS=8
