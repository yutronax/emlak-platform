# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI parser (Gemini birincil; virgülle ayrılmış çoklu key -> rotasyon)
GEMINI_API_KEYS=

# WhatsApp sidecar (Baileys)
BAILEYS_WEBHOOK_PORT=8090
BAILEYS_WEBHOOK_SECRET=
BAILEYS_WEBHOOK_HOST=127.0.0.1
WEBHOOK_URL=http://localhost:8090/baileys-webhook
WHATSAPP_SESSION_DIR=./scraper/sidecar/session

# Scraper davranışı
AUTO_SUBMIT=false
QUALITY_GATE_THRESHOLD=0.5

# iyzico (ödeme)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
IYZICO_WEBHOOK_SECRET=

# Site origin (şifre sıfırlama redirectTo için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (EML-101). Anahtar üretimi: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY yalnız sunucuda; NEXT_PUBLIC_ önekli değişkene ASLA özel anahtar yazılmaz.
# Boşsa bildirim özelliği kapalıdır (buton gizlenir, cron "disabled" döner).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@example.com
# Yalnız PUBLIC anahtarın kopyası (tarayıcı aboneliği için).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron yetkisi: Vercel Cron "Authorization: Bearer $CRON_SECRET" gönderir. Boşsa cron route 401 döner.
CRON_SECRET=
